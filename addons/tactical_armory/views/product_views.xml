<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_tactical_form_view" model="ir.ui.view">
        <field name="name">product.template.tactical.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Información Táctica" name="tactical_info">
                    <group>
                        <group string="Clasificación">
                            <field name="is_tactical_gear"/>
                            <field name="grade_quality" widget="priority"/>
                        </group>
                        <group string="Integración Square">
                            <field name="square_token" readonly="1"/>
                        </group>
                    </group>
                    <group string="Especificaciones Técnicas">
                        <field name="technical_specs" placeholder="Ej: Material de polímero, capacidad de carga, tensión del arco..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

